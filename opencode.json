{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "solidworks",
  "small_model": "openrouter/liquid/lfm-2.5-2.6b:free",
  "share": "disabled",
  "compaction": {
    "prune": true
  },
  "mcp": {
    "solidworks": {
      "type": "local",
