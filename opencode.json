{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "solidworks": {
      "type": "local",
      "command": [".venv\\Scripts\\python.exe", "-m", "sw_mcp"],
      "enabled": true,
      "timeout": 10000
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "solidworks_*": "allow"
      }
    }
  }
}
